#!/bin/sh

{{ range .packages.curl -}}
echo ""
printf '\033[34mInstalling {{.name}}\033[0m\n'
echo ""
{{ range $key, $value := (index . "environment") }}{{ $key }}={{ $value }} {{ end }}/bin/bash -c "$(curl -fsSL {{ .url | quote }})"{{ with (index . "fallback") }} || {{ . }}{{ end }}
{{ end -}}

{{ range .packages.brew -}}
echo ""
printf '\033[34mInstalling {{.name}}\033[0m\n'
echo ""
brew install{{ with (index . "formula") }} {{ . }}{{ end }}{{ with (index . "cask") }} --cask {{ . }}{{ end }}
{{ end -}}
